{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/beneficiary-analysis",
      "destination": "/api/beneficiary-analysis"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/beneficiary-analysis.js": {
      "maxDuration": 60
    }
  }
}
